# ====== API KEYS (tùy chọn) ======
# Để trống nếu chưa có — tool vẫn chạy được với nguồn RSS miễn phí.

# CryptoPanic: https://cryptopanic.com/developers/api/  (free tier)
CRYPTOPANIC_API_KEY=

# NewsAPI: https://newsapi.org/  (free tier 100 req/ngày)
NEWSAPI_API_KEY=

# ====== CẤU HÌNH CLAUDE CLI ======
# Đường dẫn tới binary claude (mặc định lấy trong PATH).
CLAUDE_BIN=claude

# Số tin tối đa gửi cho Claude phân tích mỗi lần chạy.
MAX_ITEMS=30

# ====== TỰ ĐỘNG THU THẬP ĐỊNH KỲ ======
# Bật/tắt vòng lặp tự động thu thập + phân tích nền.
AUTO_COLLECT_ENABLED=true

# Chu kỳ tự động thu thập (phút).
AUTO_COLLECT_INTERVAL_MIN=30

# Độ liên quan tối thiểu cho lần thu thập tự động.
AUTO_COLLECT_MIN_RELEVANCE=5

# ====== THÔNG BÁO RA NGOÀI (tùy chọn) ======
# Discord: tạo Webhook trong Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Telegram: tạo bot qua @BotFather để lấy token, và lấy chat_id
# (ví dụ qua https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
